# =====================================================================
# FORWARD backend — muhit sozlamalari (namuna)
# Bu faylni `.env` deb nusxalang va qiymatlarni to'ldiring.
# `.env` hech qachon git'ga qo'shilmaydi.
# =====================================================================

# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Sessiya imzosi — PRODUCTION'da MAJBURIY. Tasodifiy uzun satr:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_HOURS=12

# Ma'lumotlar bazasi yo'li (ixtiyoriy)
# DB_PATH=./data/forward.db

# Boshlang'ich admin (seed paytida ishlatiladi).
# ADMIN_PASSWORD bo'sh bo'lsa — tasodifiy parol yaratiladi va konsolga chiqadi.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Statik saytdan (boshqa domendan) ariza qabul qilish uchun CORS ruxsati.
# Vergul bilan ajrating. Bo'sh bo'lsa — faqat shu serverdan (same-origin).
# ALLOWED_ORIGINS=https://forward.uz,https://www.forward.uz

# Marketing saytni ham shu Node serveri orqali ko'rsatish (lokal demo uchun)
SERVE_SITE=false

# Reverse proxy (nginx/Render/Railway) ortida bo'lsa — haqiqiy IP uchun
TRUST_PROXY=false
